# Copy to backend/.env and fill in. Restart the backend after changes. Everything is optional.

# Length of each practice clip in seconds.
# CLIP_SECONDS=180

# New review cards introduced per day (due reviews are never capped).
# NEW_CARDS_PER_DAY=20

# Local Whisper model for podcasts and downloaded YouTube audio (Apple Silicon). The default is accurate and fast;
# the first run downloads it (~1.6 GB) from Hugging Face. Any mlx-community Whisper model works; smaller ones are
# faster but make more mistakes (mlx-community/whisper-tiny is only good for testing).
# WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

